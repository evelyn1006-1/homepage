[Unit]
Description=Princess Evelyn Homepage
After=network.target

[Service]
User=evelyn
Group=www-data
WorkingDirectory=/home/evelyn/homepage
Environment="PATH=/home/evelyn/homepage/.venv/bin"
ExecStart=/home/evelyn/homepage/.venv/bin/gunicorn \
  --config /home/evelyn/homepage/gunicorn.conf.py \
  wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
