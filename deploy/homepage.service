[Unit]
Description=Princess Evelyn Homepage
After=network.target

[Service]
User=evelyn
Group=www-data
WorkingDirectory=/home/evelyn/homepage
Environment="PATH=/usr/local/bin:/usr/local/python-3.14.4/bin:/usr/bin"
EnvironmentFile=/home/evelyn/homepage/.env
ExecStart=/usr/local/bin/gunicorn \
  --config /home/evelyn/homepage/gunicorn.conf.py \
  wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
